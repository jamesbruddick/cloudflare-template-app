{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-template-app",
  "main": "src/index.ts",
  // Capped by the oldest workerd in the toolchain - the one miniflare carries, pinned by
  // @cloudflare/vitest-plugin. A later date deploys fine but fails every test with ERR_RUNTIME_FAILURE.
  // Check with `pnpm test`; `pnpm why workerd -r` should list one version.
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees every document (it renders each route's <head> - src/document.ts); the hashed bundles
    // and fixed-name static files stay on the CDN. Add a new file in frontend/public to this list too, or
    // every request for it costs a Worker invocation. boot.css above all, since it blocks first paint.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/boot.css",
      "!/favicon.svg",
      "!/apple-touch-icon.png",
      "!/icon-192.png",
      "!/icon-512.png",
      "!/site.webmanifest",
      "!/robots.txt",
      "!/sitemap.xml"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-template-app",
      // This template's own database. In a fork, `wrangler d1 create <name>` prints the id to put here. Local
      // dev and the test suite never read it (both run a local SQLite) - only a deploy does.
      "database_id": "f118006a-4385-4112-9110-415f15b5ed3b",
      // The schema's only source of truth: one numbered file per change, applied through
      // `pnpm db:migrate:*` and by tests/setup.ts. Wrangler's default is already ./migrations - it is
      // declared so the location is visible in the config rather than implied.
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": ["API_KEY", "JWT_SECRET"]
  }
}
