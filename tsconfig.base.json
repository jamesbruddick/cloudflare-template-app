{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    // Vite's native config loader parses vite.config.ts and everything it imports without a resolver, so
    // the chain reaching it (vite-plugins.ts -> src/shared/seo.ts) has to name its files. That is only legal
    // with this on, and only safe because nothing here emits JavaScript: tsc type-checks, Vite bundles.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Biome reports unused locals and parameters as warnings, and `biome check` exits 0 on a warning - so
    // without these two, dead code passes CI silently. Here they are type errors and `pnpm typecheck` fails.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
