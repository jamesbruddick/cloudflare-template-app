{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@worker": ["../src/index.ts"],
      "@shared/*": ["../src/shared/*"]
    }
  },
  "include": ["src/**/*", "../src/shared/**/*", "../src/index.ts", "../worker-configuration.d.ts"]
}
